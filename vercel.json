{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.7.3" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "database/seeders/stubs/images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/storage/seed/(.*)", "dest": "/database/seeders/stubs/images/$1", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/favicon\\.svg", "dest": "/public/favicon.svg" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
