APP_NAME="AURCO CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=Asia/Riyadh

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite needs no server: just create database/database.sqlite
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@aurcontracting.com"
MAIL_FROM_NAME="${APP_NAME}"

# Seeded CRM login
ADMIN_NAME="AURCO Admin"
ADMIN_EMAIL=admin@aurcontracting.com
ADMIN_PASSWORD=password
